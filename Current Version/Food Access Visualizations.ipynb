      ]
     },
     "metadata": {},
     "output_type": "display_data"
    },
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Correlation of PriorityScore with each distress indicator (Hypothesis 3, want R>=0.50):\n",
      "  lasnap1share     r = +0.716  OK\n",
      "  lalowi1share     r = +0.734  OK\n",
      "  lahunv1share     r = +0.650  OK\n",
